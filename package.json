{
  "name": "dsh-cindy-host-demo",
  "version": "0.1.1",
  "private": true,
  "description": "Cindy 手机客户端连接 DSH 的 Host 侧插件：会话/消息/审批/todo/goal 的手机通道，以及配套的设置卡片",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanyuenpang/dsh-cindy-host.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "cindy",
    "device-link"
  ],
  "engines": {
    "node": ">=22"
  },
  "//files": "白名单，而非整个目录：.sandbox/（含凭据与会话）、.claw/runtime、验收日志、开发记录都不进包。见 doc/publishing.md §3。",
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "doc"
  ],
  "type": "module",
  "main": "./src/dsh-plugin.js",
  "exports": {
    ".": "./src/dsh-plugin.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "acceptance": "node tools/acceptance.mjs",
    "acceptance:sandbox": "node tools/acceptance.mjs --base http://127.0.0.1:3081",
    "sandbox": "node tools/sandbox.mjs start",
    "sandbox:stop": "node tools/sandbox.mjs stop",
    "restart": "node tools/restart-host.mjs",
    "restart:apply": "node tools/restart-host.mjs --apply",
    "audit:channels": "node tools/channel-audit.mjs",
    "verify": "npm test && npm run audit:channels && npm run acceptance",
    "demo": "node src/demo.js",
    "login": "node src/login.js",
    "logout": "node src/logout.js",
    "host": "node src/host.js",
    "host:demo": "node src/host-demo.js",
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "keytar": "^7.9.0",
    "ws": "^8.21.3"
  },
  "//optionalDependencies": "老 DSH 的 apiProxy 适配器。当前 DSH 不挂 apiProxy，插件必须能在没有它时正常 mount；见 doc/publishing.md §3 与 src/dsh-plugin.js 里那段惰性加载的注释。",
  "optionalDependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
