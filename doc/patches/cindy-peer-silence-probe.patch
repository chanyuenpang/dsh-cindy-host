+ * client 的 `pending` 是**空的** —— App 自己不再发请求、也没有在等回包,而中继仍认为
+ * 它是 online。所以:
+ *   - 「等回包」型判据(超时计数 / 探针要求有在途请求)永远不会触发;
+ *   - socket 级心跳也因为 relay 正常回 pong 而失明。
+ * 唯一能自己造出证据的办法是**主动问一次**:静默超过阈值就发一个最便宜的读,
+ * 回包到了 = 对端活着(空闲会话不会被误重建),短超时内没回包 = 下行真的死了。
+ */
+const PEER_LIVENESS_SILENCE_MS = 20_000;
+/** 检查周期:要短于静默阈值,否则一次故障要等两个周期才被发现。 */
+const PEER_LIVENESS_INTERVAL_MS = 10_000;
+/** 探测本身的超时:远小于正常请求,回包该在毫秒级到。 */
+const PEER_LIVENESS_TIMEOUT_MS = 5_000;
+/** 最便宜的被控端读通道(`maker:list-active` = 每个会话一个布尔)。 */
+const PEER_LIVENESS_CHANNEL = 'maker:list-active';
+
 /** 桌面端 presence 闪断宽限:短暂离线不立刻清空该设备的会话镜像与能力缓存。 */
 const PRESENCE_OFFLINE_WIPE_GRACE_MS = 5_000;
 
@@ -1252,8 +1271,48 @@ export function DeviceLinkProvider({ children }: { children: ReactNode }) {
       console.warn('[device-link] network listener unavailable; using heartbeat recovery');
