+    // 对端活性看门狗:与页面轮询循环**无关**的独立定时器 —— 页面循环停了它也照跑。
+    // 触发条件刻意不依赖「有在途请求」(真机实测卡住时 pending 是空的),而是主动问一次。
+    const livenessTimer = setInterval(() => {
+      const current = clientRef.current;
+      if (current === null || current.getStatus() !== 'online') return;
+      if (AppState.currentState !== 'active') return;
+      const silenceMs = current.peerSilenceMs();
+      if (silenceMs < PEER_LIVENESS_SILENCE_MS) return;
+      // 只探「已经建立了 link」的设备:没有 link 就没有可失去的下行。
+      let target: string | null = null;
+      for (const plan of registryRef.current.snapshot()) {
+        if (
+          typeof plan.deviceId === 'string'
+          && plan.deviceId !== ''
+          && current.getPeerLinkGeneration(plan.deviceId) > 0
+        ) {
+          target = plan.deviceId;
+          break;
+        }
+      }
+      if (target === null) return;
+      const probedDevice = target;
+      mobileDebugLog('debug', 'device-link', 'peer liveness probe', {
+        deviceId: probedDevice,
+        silenceMs: Math.round(silenceMs),
+      });
+      void current
+        .invoke(probedDevice, { channel: PEER_LIVENESS_CHANNEL, args: [] }, PEER_LIVENESS_TIMEOUT_MS)
+        .catch((error: unknown) => {
+          const code = (error as { code?: string } | null)?.code;
+          mobileDebugLog('warn', 'device-link', 'peer liveness probe failed; rebuilding connection', {
+            deviceId: probedDevice,
+            code: code ?? String((error as { message?: string } | null)?.message ?? error),
+          });
+          current.restartConnection('peer-liveness-probe');
+          void rehydrateWithClient(current);
+        });
+    }, PEER_LIVENESS_INTERVAL_MS);
+
     return () => {
       disposed = true;
+      clearInterval(livenessTimer);
       diagnostics.background();
       recoveryDiagnostics.delete(client);
       networkSubscription?.remove();
