         // 与桌面控制端同一张协议契约表,不受此默认值影响。
         requestTimeoutMs: 15_000,
+        // peer 级静默探针(2026-09-17 实测)。挑照片回前台后 socket 半开时:上面的
+        // 心跳只量「本机↔relay」,而 relay 每 10s 主动回一次 pong,于是「20s 内有
+        // 任意入站帧就清零」让半开检测永久失明 —— 手机每秒重试同一个读、2.5 分钟
+        // 不恢复,只有重启 App 才恢复。开启后追加一条**对端**活性判据:同一 peer
+        // 连续两次请求超时、且这 20s 内对端一个带 src 的帧都没发 → 强制重建连接
+        // (restartConnection 会一并复位 link 状态,host 侧重开链路)。
+        // 窗口必须 ≥ requestTimeoutMs(15s),否则第二次超时时静默时长还凑不满窗口;
+        // 两次超时是刻意的门槛:单次慢请求(桌面正忙)不该拆掉共享 socket。
+        peerSilenceProbeMs: 20_000,
       },
     });
     clientRef.current = client;
diff --git a/packages/device-link/src/__tests__/client.test.ts b/packages/device-link/src/__tests__/client.test.ts
index dee0caa8b..1f7c9f334 100644
--- a/packages/device-link/src/__tests__/client.test.ts
+++ b/packages/device-link/src/__tests__/client.test.ts
@@ -8744,3 +8744,155 @@ describe('定时重发的单趟预算(TRANSPORT_RETRY_PASS_BUDGET)', () => {
     h.client.stop();
   }, 10_000);
 });
+
+/**
+ * peer 级静默探针(2026-09-17 安卓端实测的补偿机制)。
+ *
+ * 现场:挑照片回前台后 socket 半开,手机每秒重试同一个读、2.5 分钟不恢复,只有重启
+ * App 才恢复。原因是**所有既有活性判据都是 relay 级**的:relay 每 10s 回一次 pong,
+ * 手机的半开检测(`client.ts` 心跳)「20 秒内有任意入站帧就清零」因此永久失明。
+ * 这里断言新增的 peer 级判据:只有带 `src` 的对端帧算「对端还在说话」。
+ */
+describe('peer 级静默探针', () => {
+  it('默认关闭:relay 可达但对端全程静默,连续请求超时也不重建共享 socket', async () => {
+    // pingIntervalMs 拉长把「本机↔relay」的判死逻辑摘出去:这样唯一可能重建的
+    // 只有 peer 级探针,断言才有意义。
+    const h = makeHarness({ timing: { pingIntervalMs: 60_000, requestTimeoutMs: 20 } });
+    h.client.start();
+    await tick();
+    const socket = h.current();
+    socket.ack();
+
+    await expect(h.client.invoke('dev-b', { channel: 'x', args: [] }, 20))
+      .rejects.toMatchObject({ code: 'INVOKE_TIMEOUT' });
+    await expect(h.client.invoke('dev-b', { channel: 'x', args: [] }, 20))
+      .rejects.toMatchObject({ code: 'INVOKE_TIMEOUT' });
+    await tick(40);
+
+    expect(h.sockets).toHaveLength(1);
+    h.client.stop();
+  });
+
+  it('开启后:同一 peer 连续两次超时且对端持续静默 → 强制重建连接', async () => {
+    const h = makeHarness({
+      timing: { pingIntervalMs: 60_000, requestTimeoutMs: 20, peerSilenceProbeMs: 35 },
+    });
+    h.client.start();
+    await tick();
+    const socket = h.current();
+    socket.ack();
+
+    // 第一次超时:连续计数只有 1,单次慢请求不拆链路。
+    await expect(h.client.invoke('dev-b', { channel: 'x', args: [] }, 20))
+      .rejects.toMatchObject({ code: 'INVOKE_TIMEOUT' });
+    await tick(5);
+    expect(h.sockets).toHaveLength(1);
+
+    // 第二次超时:连续两次 + 静默已过窗口 → 重建。
+    await expect(h.client.invoke('dev-b', { channel: 'x', args: [] }, 20))
+      .rejects.toMatchObject({ code: 'INVOKE_TIMEOUT' });
+    await tick(30);
+
+    expect(h.sockets.length).toBeGreaterThan(1);
+    expect(socket.terminated || socket.closed !== null).toBe(true);
+    h.client.stop();
+  });
+
+  it('开启后:对端仍有帧(带 src)时永不判定静默', async () => {
+    const h = makeHarness({
+      timing: { pingIntervalMs: 60_000, requestTimeoutMs: 20, peerSilenceProbeMs: 35 },
+    });
+    h.client.start();
+    await tick();
+    const socket = h.current();
+    socket.ack();
+
+    await expect(h.client.invoke('dev-b', { channel: 'x', args: [] }, 20))
+      .rejects.toMatchObject({ code: 'INVOKE_TIMEOUT' });
+    // 对端发来一帧:连续超时计数清零,静默窗口重新开始计时。
+    socket.push({
+      v: PROTOCOL_VERSION,
+      kind: 'push',
+      src: 'dev-b',
+      payload: { channel: 'demo', payload: {} },
+    });
+    await expect(h.client.invoke('dev-b', { channel: 'x', args: [] }, 20))
+      .rejects.toMatchObject({ code: 'INVOKE_TIMEOUT' });
+    await tick(30);
+
+    expect(h.sockets).toHaveLength(1);
+    h.client.stop();
+  });
+
+  it('开启后:relay 已判定该 peer 离线时不重建(DEVICE_OFFLINE 是路由事实)', async () => {
+    const h = makeHarness({
+      timing: { pingIntervalMs: 60_000, requestTimeoutMs: 20, peerSilenceProbeMs: 35 },
+    });
+    h.client.start();
+    await tick();
+    const socket = h.current();
+    socket.ack();
+
+    const offline = h.client.invoke('dev-b', { channel: 'x', args: [] }, 20);
+    const sent = socket.sent.find((e) => e.kind === 'invoke')!;
+    socket.push({
+      v: PROTOCOL_VERSION,
+      kind: 'relay-error',
+      id: sent.id,
+      payload: { code: 'DEVICE_OFFLINE', message: 'offline' },
+    });
+    await expect(offline).rejects.toMatchObject({ code: 'DEVICE_OFFLINE' });
+
+    await expect(h.client.invoke('dev-b', { channel: 'x', args: [] }, 20))
+      .rejects.toMatchObject({ code: 'INVOKE_TIMEOUT' });
+    await expect(h.client.invoke('dev-b', { channel: 'x', args: [] }, 20))
+      .rejects.toMatchObject({ code: 'INVOKE_TIMEOUT' });
+    await tick(30);
+
+    expect(h.sockets).toHaveLength(1);
+    h.client.stop();
+  });
+
+  it('开启后:回前台探针只在「确实在等对端回包」时才重建', async () => {
+    vi.useFakeTimers();
+    // peerSilenceProbeMs 取 1ms:这一条断言的是**闸门**(有没有 pending),
+    // 不依赖窗口长度,避免在 fake timers 下把断言压在时钟精度上。
+    const h = makeHarness({
+      timing: { pingIntervalMs: 60_000, peerSilenceProbeMs: 1 },
+    });
+    try {
+      h.client.start();
+      await vi.advanceTimersByTimeAsync(0);
+      const socket = h.current();
+      socket.ack();
+
+      // (1) 空闲回前台:没有在途请求 → 探针超时也不该拆掉健康的共享 socket。
+      h.client.notifyNetworkChanged({ urgent: true });
+      await vi.advanceTimersByTimeAsync(16_000);
+      expect(h.sockets).toHaveLength(1);
+
+      // (2) 有 pending 但**还没有任何超时证据** → 也不重建:长执行通道运行期间
+      //     被控端本来就可能几十秒不发帧,那种请求不该被探针打成失败。
+      const inFlight = h.client.invoke('dev-b', { channel: 'x', args: [] }, 60_000);
+      void inFlight.catch(() => {});
+      h.client.notifyNetworkChanged({ urgent: true });
+      await vi.advanceTimersByTimeAsync(16_000);
+      expect(h.sockets).toHaveLength(1);
+
+      // (3) 已经有过一次「等不到对端而超时」+ 仍在等回包 → 探针超时后重建。
+      const timedOut = h.client.invoke('dev-b', { channel: 'x', args: [] }, 20);
+      const timedOutAssertion = expect(timedOut).rejects
+        .toMatchObject({ code: 'INVOKE_TIMEOUT' });
+      await vi.advanceTimersByTimeAsync(25);
+      await timedOutAssertion;
+      expect(h.sockets).toHaveLength(1);
+
+      h.client.notifyNetworkChanged({ urgent: true });
+      await vi.advanceTimersByTimeAsync(16_000);
+      expect(h.sockets.length).toBeGreaterThan(1);
+    } finally {
+      h.client.stop();
+      vi.useRealTimers();
+    }
+  });
+});
