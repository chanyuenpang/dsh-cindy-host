+  /** peer 级静默探针是否开启(默认关闭,桌面端既有曲线不变)。 */
+  private peerSilenceProbeEnabled(): boolean {
+    return this.timing.peerSilenceProbeMs > 0;
+  }
+
+  /**
+   * 是否已能判定「对端方向哑到必须重建连接」。
+   *
+   * 刻意保守:relay 已判定该 peer 离线时不动手(DEVICE_OFFLINE 是路由事实,不是
+   * socket 问题);同一窗口内最多重建一次,避免重连风暴。
+   */
+  private shouldRebuildForPeerSilence(
+    now: number,
+    dst: string | undefined,
+    opts?: { requirePending?: boolean },
+  ): boolean {
+    const window = this.timing.peerSilenceProbeMs;
+    if (!(window > 0)) return false;
+    if (this.status !== 'online') return false;
+    // 0 = 本次生命周期内还没重建过(单调时钟的绝对值可能很小,不能只比差值)。
+    if (this.peerSilenceRebuildAt !== 0 && now - this.peerSilenceRebuildAt < window) return false;
+    if (dst !== undefined && this.peerOfflineNotifiedGeneration.has(dst)) return false;
+    if (opts?.requirePending === true && !this.hasPeerTimeoutEvidence()) return false;
+    return now - this.lastPeerInboundAt >= window;
+  }
+
+  /**
+   * 是否已经有「请求等不到对端而超时」的证据,且此刻仍有请求在等回包。
+   *
+   * 回前台探针只凭「有 pending」还不足以拆共享 socket:长执行通道
+   * (desktop-cmd:run / worktree:create 等按通道放宽超时的请求)运行期间被控端
+   * 本来就可能几十秒不发一个帧,那时重建会把**正在执行**的命令打成失败。
+   * 超时证据天然排除这种请求——它们的超时被放宽到分钟级,不会先超时。
+   */
+  private hasPeerTimeoutEvidence(): boolean {
+    if (this.pending.size === 0) return false;
+    for (const [deviceId, streak] of this.peerTimeoutStreak) {
+      if (streak < 1) continue;
+      if (this.peerOfflineNotifiedGeneration.has(deviceId)) continue;
+      return true;
+    }
+    return false;
+  }
+
+  /**
+   * 记录一次请求超时,并在「同一 peer 连续两次超时 + 对端持续静默」时重建连接。
+   *
+   * 连续计数不需要额外的时间窗:收到该 peer 的任一帧(`handleFrame`)、或本次重建
+   * 之后就清零,所以「连续两次」必然意味着这两次之间对端一个字都没说 —— 那正是要
+   * 抓的形态。加窗口反而会在测试/CI 的真实开销下把证据判散。
+   */
+  private notePeerRequestTimeout(dst: string, now: number): void {
+    const window = this.timing.peerSilenceProbeMs;
+    if (!(window > 0)) return;
+    const streak = (this.peerTimeoutStreak.get(dst) ?? 0) + 1;
+    this.peerTimeoutStreak.set(dst, streak);
+    if (streak < 2) return;
+    if (!this.shouldRebuildForPeerSilence(now, dst)) return;
+    this.peerSilenceRebuildAt = now;
+    this.peerTimeoutStreak.delete(dst);
+    this.log.warn(
+      'peer silence detected, forcing reconnect'
+      + ` (peer=${dst}, silentForMs=${now - this.lastPeerInboundAt},`
+      + ` pending=${this.pending.size}, timeouts=${streak})`,
+    );
+    this.restartConnection('peer-silence');
+  }
+
