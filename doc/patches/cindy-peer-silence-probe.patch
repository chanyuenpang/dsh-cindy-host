@@ -305,6 +323,7 @@ const DEFAULT_TIMING: DeviceLinkTiming = {
   // 允许弱网在一个额外周期内恢复；真正无响应仍由连续 miss + 无入站流量判定。
   pongMissLimit: 3,
   requestTimeoutMs: 30_000,
